# =============================================================
# DEVELOPPEMENT  ->  copier ce fichier en .env et adapter
# PRODUCTION     ->  remplir toutes les sections obligatoires
# =============================================================

# --- Flask ---
SECRET_KEY=changez-moi-en-production-cle-longue-et-aleatoire
FLASK_ENV=development

# --- Base de donnees ---
# Dev  : laisser vide (SQLite automatique)
# Prod : decommenter et remplir
# DATABASE_URL=mysql+pymysql://user:password@localhost/ticketsecure

# --- Mail ---
# Dev  : Mailhog (lancer : mailhog)  UI : http://localhost:8025
# Prod : renseigner le serveur SMTP de l'ecole ou un relay externe
MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_USE_TLS=false
# MAIL_USERNAME=
# MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@ticketsecure.local

# --- Compte administrateur (utilise par init_prod.py) ---
# Ne renseigner qu'en production, sur le serveur uniquement.
# Ces valeurs ne doivent JAMAIS etre committees sur git.
# ADMIN_EMAIL=admin@votre-domaine.fr
# ADMIN_PASSWORD=MotDePasseTresLong!2025
# ADMIN_PRENOM=Admin
# ADMIN_NOM=TicketSecure