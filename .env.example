# =============================================================
# DEVELOPPEMENT  ->  copier ce fichier en .env et adapter
# PRODUCTION     ->  remplir toutes les sections obligatoires
# =============================================================

# --- Flask ---
SECRET_KEY=changez-moi-en-production-cle-longue-et-aleatoire
# Modes disponibles :
#   development -> DEBUG=True,  SQLite  (poste local)
#   server      -> DEBUG=False, SQLite  (serveur ecole sans MySQL)
#   production  -> DEBUG=False, MySQL   (prod complete)
FLASK_ENV=development

# --- Base de donnees ---
# Dev  : laisser vide (SQLite automatique)
# Prod : decommenter et remplir
# DATABASE_URL=mysql+pymysql://user:password@localhost/ticketsecure

# --- Mail ---
# Dev  : Mailhog (lancer : mailhog)  UI : http://localhost:8025
# Prod : renseigner le serveur SMTP de l'ecole ou un relay externe
MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_USE_TLS=false
# MAIL_USERNAME=
# MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@ticketsecure.local

# --- Compte administrateur (utilise par init_prod.py) ---
# Ne renseigner que sur le serveur, jamais commiter ces valeurs.
#
# Methode recommandee (hash pre-genere, mot de passe jamais transmis) :
#   1. Sur votre machine : python generate_hash.py
#   2. Coller le hash ci-dessous sur le serveur
# ADMIN_EMAIL=admin@votre-domaine.fr
# ADMIN_PASSWORD_HASH=$2b$12$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ADMIN_PRENOM=Admin
# ADMIN_NOM=TicketSecure
#
# Methode alternative (deconseille, mot de passe en clair) :
# ADMIN_PASSWORD=MotDePasseTresLong!2025