@startuml activity_achat
title Diagramme d'Activité – Achat de tickets

skinparam activity {
  BackgroundColor #EBF3FB
  BorderColor #2D6CDF
  ArrowColor #1B2A4A
  StartColor #2D6CDF
  EndColor #1B2A4A
  DiamondBackgroundColor #FFF8E1
  DiamondBorderColor #F57F17
}
skinparam note {
  BackgroundColor #FFFDE7
  BorderColor #F57F17
}

|Utilisateur|
start
:Consulte la page détail\nd'un événement;

if (Connecté ?) then (non)
  :Voit bouton "Se connecter";
  stop
else (oui)
endif

if (places_restantes == 0 ?) then (oui)
  :Voit message "Événement complet";
  stop
else (non)
endif

:Choisit une quantité (1 à 4)\net soumet le formulaire;

|Système|
:Vérifier CSRF token;
:Valider quantite ∈ [1, 4];
if (quantité invalide ?) then (oui)
  :Flash "Quantité invalide";
  |Utilisateur|
  :Corrige la quantité;
  stop
else (non)
endif

:Verrouiller la ligne spectacle\n(SELECT … FOR UPDATE);
note right
  Verrouillage pessimiste : empêche
  deux achats simultanés de passer
  quand une seule place reste.
end note

:Relire places_restantes (valeur fraîche);
if (places_restantes < quantite ?) then (oui)
  :ROLLBACK / libérer verrou;
  :Flash "Pas assez de places";
  |Utilisateur|
  :Voit message d'erreur;
  stop
else (non)
endif

:Calculer quota déjà acheté\n(SUM commandes user/spectacle);
if (quota + quantite > 4 ?) then (oui)
  :ROLLBACK / libérer verrou;
  :Flash "Quota de 4 tickets déjà atteint";
  |Utilisateur|
  :Voit message d'erreur;
  stop
else (non)
endif

:Créer Commande\n(montant, numero_facture=FAC-XXXXX,\ncode_qr_ticket=UUID);
:UPDATE spectacle\nSET places_restantes -= quantite;
:COMMIT (verrou libéré);

:Appeler envoyer_confirmation_achat(commande);
if (SMTP disponible ?) then (non)
  :Logger l'erreur SMTP\n(commande reste valide);
else (oui)
  :E-mail de confirmation envoyé;
endif

:Flash "Commande confirmée !";
:Rediriger vers /commandes/facture/<id>;

|Utilisateur|
:Consulte la facture\n(récapitulatif + numéro de commande);
stop

@enduml
