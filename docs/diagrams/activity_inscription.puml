@startuml activity_inscription
title Diagramme d'Activité – Inscription et activation du compte

skinparam activity {
  BackgroundColor #EBF3FB
  BorderColor #2D6CDF
  ArrowColor #1B2A4A
  StartColor #2D6CDF
  EndColor #1B2A4A
  DiamondBackgroundColor #FFF8E1
  DiamondBorderColor #F57F17
}
skinparam note {
  BackgroundColor #FFFDE7
  BorderColor #F57F17
}

|Visiteur|
start
:Accède au formulaire d'inscription;
:Remplit prénom, nom, e-mail,\nmot de passe + confirmation;
:Soumet le formulaire;

|Système|
:Vérifier le rate limit\n(10 inscriptions / heure / IP);
if (limite dépassée ?) then (oui)
  :Retourner erreur 429;
  stop
else (non)
endif

:Normaliser l'e-mail (lowercase, strip);
:Rechercher l'e-mail en base;
if (e-mail déjà enregistré ?) then (oui)
  :Retourner réponse générique\n(sans confirmer l'existence);
  |Visiteur|
  :Voit message info neutre;
  stop
else (non)
endif

:Créer Utilisateur\n(est_actif = False);
note right
  Le compte est inactif
  jusqu'à la vérification e-mail.
end note
:Hacher le mot de passe\n(bcrypt, 12 rounds);
:Générer token_verification\n(secrets.token_urlsafe(32));
:Enregistrer en base (INSERT);
:Journaliser l'inscription\n(LogConnexion "Inscription / Succès");
:COMMIT;
:Envoyer e-mail d'activation\n(lien /auth/verifier/<token>);

if (SMTP disponible ?) then (non)
  :Logger l'erreur SMTP\n(pas de blocage utilisateur);
else (oui)
endif

:Flash "Vérifiez votre e-mail";
:Rediriger vers /auth/connexion;

|Visiteur|
:Reçoit l'e-mail d'activation;
:Clique le lien de confirmation;

|Système|
:Rechercher l'utilisateur\npar token_verification;
if (token valide ?) then (non)
  :Retourner 404;
  stop
else (oui)
endif
:Activer le compte\n(est_actif = True);
:Effacer token_verification;
:COMMIT;
:Flash "Compte activé";
:Rediriger vers /auth/connexion;

|Visiteur|
:Peut se connecter;
stop

@enduml
