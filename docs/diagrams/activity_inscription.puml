@startuml activity_inscription
title Diagramme d'Activité – Création de compte & Vérification e-mail

skinparam backgroundColor White
skinparam activity {
  BackgroundColor LightCyan
  BorderColor DarkBlue
  ArrowColor DarkBlue
}

|Visiteur|
start
:Accéder au formulaire\nd'inscription;
:Saisir : nom, prénom, e-mail,\nmot de passe, adresse facturation;

|Système|
:Valider le format des champs\n(côté serveur);

if (Données valides ?) then (oui)
  :Vérifier unicité de l'e-mail\n(SELECT en BDD);

  if (E-mail déjà utilisé ?) then (non)
    :Hacher le mot de passe\n(bcrypt, coût = 12);
    :Vérifier robustesse MDP\n(longueur >= 12, complexité);

    if (MDP robuste ?) then (oui)
      :Créer enregistrement utilisateur\n(est_actif = FALSE);
      :Générer token de vérification\n(secrets.token_urlsafe, 1h);
      :Envoyer e-mail de confirmation\navec lien signé;

      |Visiteur|
      :Recevoir l'e-mail;
      :Cliquer sur le lien de vérification;

      |Système|
      :Vérifier token (valide + non expiré);

      if (Token valide ?) then (oui)
        :Activer le compte\n(est_actif = TRUE);
        :Invalider le token;
        :Rediriger vers la page de connexion;

        |Visiteur|
        :Se connecter;
        stop
      else (non – expiré ou invalide)
        :Afficher erreur :\n"Lien invalide ou expiré";
        :Proposer de renvoyer un e-mail;
        stop
      endif
    else (non – trop faible)
      |Système|
      :Afficher les règles de complexité;
      |Visiteur|
      :Corriger le mot de passe;
      stop
    endif
  else (oui – déjà utilisé)
    |Système|
    :Afficher message générique\n(ne pas confirmer l'existence du compte);
    stop
  endif
else (non – données invalides)
  :Afficher les erreurs de validation;
  |Visiteur|
  :Corriger les champs;
  stop
endif

@enduml
